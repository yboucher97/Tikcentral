[Unit]
Description=Tikcentral public WinBox relay
After=network-online.target wg-quick@wg0.service tikcentral.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=tikcentral
Group=tikcentral
WorkingDirectory=/opt/tikcentral/current
EnvironmentFile=/etc/tikcentral/tikcentral.env
ExecStart=/opt/tikcentral/current/.venv/bin/python3 -m app.winbox_proxy
Restart=on-failure
RestartSec=3
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/lib/tikcentral

[Install]
WantedBy=multi-user.target
