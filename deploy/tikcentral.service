[Unit]
Description=Tikcentral MikroTik Hub API
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=tikcentral
Group=tikcentral
WorkingDirectory=/opt/tikcentral/current
EnvironmentFile=/etc/tikcentral/tikcentral.env
ExecStart=/opt/tikcentral/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --workers 1
Restart=on-failure
RestartSec=3
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/tikcentral /etc/wireguard

[Install]
WantedBy=multi-user.target
