ADMIN_API_KEY=CHANGE_ME
DASHBOARD_PASSWORD=CHANGE_ME
DB_PATH=/var/lib/tikcentral/tikcentral.db
WG_HELPER=/usr/local/sbin/tikcentral-wg-peer
WG_SERVER_PUBLIC_KEY=GENERATED_BY_BOOTSTRAP
WG_ENDPOINT=tikcentral.opticable.ca:51820
PUBLIC_HOSTNAME=tikcentral.opticable.ca
WG_ROUTER_POOL=10.250.1.0/24
WG_ALLOWED_NETWORK=10.250.0.0/16
TOKEN_TTL_HOURS=24
ONLINE_SECONDS=180
TEMP_ACCESS_DAYS=5
WINBOX_PUBLIC_PORT_MIN=20000
WINBOX_PUBLIC_PORT_MAX=49999
WINBOX_TARGET_PORT=8291
WINBOX_RESCAN_SECONDS=10

# Central Tikcentral operations settings
TIKCENTRAL_TIMEZONE=America/Toronto
TIKCENTRAL_ROUTER_USER=tikcentral
TIKCENTRAL_SSH_KEY=/etc/tikcentral/ssh/tikcentral_ed25519
TIKCENTRAL_KNOWN_HOSTS=/var/lib/tikcentral/known_hosts
TIKCENTRAL_SSH_TIMEOUT=20
TIKCENTRAL_READ_RETRIES=1
TIKCENTRAL_MUTATION_TIMEOUT=90
TIKCENTRAL_MAX_COMMAND_LENGTH=200000
TIKCENTRAL_FLEET_WORKERS=8
TIKCENTRAL_TELEMETRY_WORKERS=6
TIKCENTRAL_DRIFT_WORKERS=3
TIKCENTRAL_TELEMETRY_INTERVAL=300
TIKCENTRAL_DRIFT_INTERVAL=1800
TIKCENTRAL_TELEMETRY_RETENTION_ROWS=9000
TIKCENTRAL_GUARDIAN_RETENTION_ROWS=45000
TIKCENTRAL_EVENT_RETENTION_ROWS=5000
TIKCENTRAL_EVENT_INFO_RETENTION_ROWS=750
TIKCENTRAL_EVENT_DEDUP_SECONDS=300
TIKCENTRAL_CORE_TELEMETRY_TIMEOUT=12
TIKCENTRAL_ROUTERBOOT_TELEMETRY_TIMEOUT=8
TIKCENTRAL_POLICY_PROBE_TIMEOUT=8
TIKCENTRAL_DRIFT_EXPORT_TIMEOUT=90
TIKCENTRAL_UPDATE_CHECK_TIMEOUT=90
TIKCENTRAL_ROUTEROS_RETURN_TIMEOUT=1200
TIKCENTRAL_ROUTERBOOT_RETURN_TIMEOUT=900
ROUTER_BACKUP_DIR=/var/backups/tikcentral/routers
TIKCENTRAL_BACKUP_FALLBACK=/var/lib/tikcentral/router-backups
TIKCENTRAL_RESCUE_ADDRESS=10.255.255.1/24
TIKCENTRAL_RESCUE_NETWORK=10.255.255.0/24
TIKCENTRAL_RESCUE_POOL=10.255.255.100-10.255.255.200
TIKCENTRAL_RESCUE_DNS=1.1.1.1

# Shared UI asset cache version. Change only when replacing static branding files.
TIKCENTRAL_ASSET_VERSION=7
